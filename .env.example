# Copy to .env and fill in what you need. .env is gitignored.

# --- Google Gemini (projects 06-08) ---
GOOGLE_API_KEY=

# --- X / Twitter API (project 03) ---
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
LIVE_COLLECTION=0

# --- AWS Redshift (project 03, optional) ---
REDSHIFT_HOST=
REDSHIFT_USER=
REDSHIFT_PASSWORD=
REDSHIFT_DB=dev
REDSHIFT_PORT=5439

# --- MySQL (projects 03, 12) ---
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=

# --- PostgreSQL (projects 02, 09) ---
POSTGRES_HOST=localhost
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
